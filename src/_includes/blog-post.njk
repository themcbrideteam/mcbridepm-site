---
layout: base.njk
ogType: article
---

{% block head %}
<style>
  .blog-header {
    background: linear-gradient(135deg, #060644 0%, #0d0d5d 100%);
    color: white;
    padding: 3rem 0;
    margin-bottom: 2rem;
  }
  .blog-breadcrumb {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }
  .blog-breadcrumb a {
    color: #b2995a;
    text-decoration: none;
  }
  .blog-breadcrumb a:hover {
    text-decoration: underline;
  }
  .blog-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .blog-metadata {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.95rem;
    opacity: 0.9;
  }
  .blog-metadata-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tag-badge {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .tag-badge--owners {
    background-color: #060644;
    color: white;
  }
  .tag-badge--tenants {
    background-color: #b2995a;
    color: white;
  }
  .content-section {
    padding: 3rem 0;
  }
  .content-narrow {
    max-width: 800px;
    margin: 0 auto;
  }
  .blog-body {
    line-height: 1.8;
    font-size: 1.05rem;
    color: #333;
  }
  .blog-body h2 {
    font-size: 1.8rem;
    font-weight: 700;
    color: #060644;
    margin-top: 2.5rem;
    margin-bottom: 1.2rem;
    line-height: 1.3;
  }
  .blog-body h2:first-child {
    margin-top: 0;
  }
  .blog-body h3 {
    font-size: 1.3rem;
    font-weight: 600;
    color: #060644;
    margin-top: 1.8rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .blog-body p {
    margin-bottom: 1.2rem;
  }
  .blog-body strong {
    font-weight: 600;
    color: #060644;
  }
  .blog-body a {
    color: #b2995a;
    text-decoration: none;
  }
  .blog-body a:hover {
    text-decoration: underline;
  }
  .blog-body ul {
    margin-left: 2rem;
    margin-bottom: 1.2rem;
  }
  .blog-body ul li {
    margin-bottom: 0.6rem;
    list-style: disc;
  }
  .snippet-box {
    background-color: #f5f1e8;
    border-left: 5px solid #b2995a;
    padding: 1.5rem;
    margin: 2rem 0;
    border-radius: 4px;
    font-size: 1.05rem;
    line-height: 1.8;
    font-weight: 500;
    color: #333;
  }
  .faq-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
  }
  .faq-item {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background-color: #fafafa;
    border-radius: 6px;
    border: 1px solid #e8e8e8;
  }
  .faq-question {
    font-size: 1.2rem;
    font-weight: 600;
    color: #060644;
    margin-bottom: 0.8rem;
  }
  .faq-answer {
    color: #333;
    line-height: 1.8;
  }
  .cta-box {
    background: linear-gradient(135deg, #060644 0%, #1a1a4d 100%);
    color: white;
    padding: 2.5rem;
    border-radius: 8px;
    margin: 3rem 0;
    text-align: center;
  }
  .cta-box h3 {
    color: white;
    margin-top: 0;
    font-size: 1.5rem;
  }
  .cta-box p {
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 1.5rem;
  }
  .cta-box .contact-info {
    margin-top: 1.5rem;
    font-weight: 600;
  }
  .cta-box .contact-info a {
    color: #b2995a;
    text-decoration: none;
  }
  .cta-box .contact-info a:hover {
    text-decoration: underline;
  }
  .author-sig {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
    font-size: 0.95rem;
    color: #666;
    line-height: 1.8;
  }
  .author-sig strong {
    display: block;
    color: #060644;
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .back-to-blog {
    margin-bottom: 2rem;
  }
  .back-to-blog a {
    color: #b2995a;
    text-decoration: none;
    font-weight: 600;
  }
  .back-to-blog a:hover {
    text-decoration: underline;
  }
</style>
{% endblock %}

{% block content %}
<!-- JSON-LD SCHEMA FOR GEO/AEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ dateModified | isoDate or (date | isoDate) }}",
  "author": {
    "@type": "Person",
    "name": "{{ author or 'Noah McBride' }}",
    "jobTitle": "{{ authorTitle or 'Principal Broker' }}",
    "url": "https://mcbride-pm.com/about/",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://mcbride-pm.com/#organization"
    }
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://mcbride-pm.com/#organization",
    "name": "McBride Property Management",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mcbride-pm.com/images/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://mcbride-pm.com/blog/{{ page.fileSlug }}/"
  },
  "inLanguage": "en-US"{% if image %},
  "image": {
    "@type": "ImageObject",
    "url": "https://mcbride-pm.com{{ image }}",
    "width": 1200,
    "height": 630
  }{% else %},
  "image": "https://mcbride-pm.com/og-image.jpg"{% endif %}{% if keywords %},
  "keywords": {{ keywords | dump | safe }}{% endif %}{% if articleSection %},
  "articleSection": {{ articleSection | dump | safe }}{% endif %}{% if wordCount %},
  "wordCount": {{ wordCount }}{% endif %}
}
</script>

{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{% for q in faqs %}{
    "@type": "Question",
    "name": {{ q.question | dump | safe }},
    "acceptedAnswer": {
      "@type": "Answer",
      "text": {{ q.answer | dump | safe }}
    }
  }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
{% endif %}

{% if howTo %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ howTo.name | dump | safe }},
  "description": {{ howTo.description | dump | safe }}{% if howTo.totalTime %},
  "totalTime": "{{ howTo.totalTime }}"{% endif %},
  "step": [{% for s in howTo.steps %}{
    "@type": "HowToStep",
    "position": {{ loop.index }},
    "name": {{ s.name | dump | safe }},
    "text": {{ s.text | dump | safe }}{% if s.url %},
    "url": "{{ s.url }}"{% endif %}
  }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
{% endif %}

<!-- Breadcrumb -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://mcbride-pm.com/"},
    {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://mcbride-pm.com/blog/"},
    {"@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}}
  ]
}
</script>

<!-- BLOG HEADER -->
<div class="blog-header">
  <div class="container">
    <div class="blog-breadcrumb">
      <a href="/">Home</a> > <a href="/blog/">Blog</a> > {{ title }}
    </div>
    <h1 class="blog-title">{{ title }}</h1>
    <div class="blog-metadata">
      <span class="blog-metadata-item">{{ date | readableDate }}</span>
      <span class="blog-metadata-item">&middot;</span>
      <span class="blog-metadata-item">{{ readTime or '5' }} min read</span>
      <span class="blog-metadata-item">
        <span class="tag-badge {% if category == 'Property Owners' %}tag-badge--owners{% elif category == 'Tenants' %}tag-badge--tenants{% else %}tag-badge--owners{% endif %}">{{ category }}</span>
      </span>
    </div>
  </div>
</div>

{% if image %}
<div style="width:100%; max-height:420px; overflow:hidden; line-height:0;">
  <img src="{{ image }}" alt="{{ imageAlt or title }}" style="width:100%; height:420px; object-fit:cover; display:block;">
</div>
{% endif %}

<!-- BLOG CONTENT -->
<section class="content-section">
  <div class="container content-narrow">
    <div class="back-to-blog">
      <a href="/blog/">&larr; Back to Blog</a>
    </div>

    <div class="blog-body">
      {{ content | safe }}
    </div>

    <!-- CTA -->
    <div class="cta-box">
      <h3>{{ ctaTitle or 'Ready to Talk Property Management?' }}</h3>
      <p>{{ ctaText or 'McBride Property Management handles the details while you enjoy the returns.' }}</p>
      <div class="contact-info">
        <p>Talk to our team about your property</p>
        <p><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a><br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
    </div>

    <!-- Author -->
    <div class="author-sig">
      <strong>Noah McBride, Broker</strong>
      {{ site.name }}<br>
      706.701.5940<br>
      Guiding you home.
    </div>
  </div>
</section>
{% endblock %}
