---
layout: base.njk
ogType: article
---

{% block head %}
{# Post styles live in /css/styles.css (dark theme, shared with every inner page) #}
{# Social syndication metadata — consumed by the n8n GBP workflow #}
{% if socialTeaser %}<meta name="social-teaser" content="{{ socialTeaser | replace("\n", " ") | trim }}">{% endif %}
{% if socialImage %}<meta name="social-image" content="{{ site.url }}{{ socialImage }}">{% endif %}
{% if socialImageAlt %}<meta name="social-image-alt" content="{{ socialImageAlt }}">{% endif %}
{% endblock %}

{% block content %}
<!-- JSON-LD SCHEMA FOR GEO/AEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ dateModified | isoDate or (date | isoDate) }}",
  "author": {
    "@type": "Person",
    "name": "{{ author or 'Noah McBride' }}",
    "jobTitle": "{{ authorTitle or 'Principal Broker' }}",
    "url": "https://mcbride-pm.com/about/",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://mcbride-pm.com/#organization"
    }
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://mcbride-pm.com/#organization",
    "name": "McBride Property Management",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mcbride-pm.com/images/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://mcbride-pm.com/blog/{{ page.fileSlug }}/"
  },
  "inLanguage": "en-US"{% if image and (image | exists) %},
  "image": {
    "@type": "ImageObject",
    "url": "https://mcbride-pm.com{{ image }}",
    "width": 1200,
    "height": 630
  }{% else %},
  "image": "https://mcbride-pm.com/og-image.jpg"{% endif %}{% if keywords %},
  "keywords": {{ keywords | dump | safe }}{% endif %}{% if articleSection %},
  "articleSection": {{ articleSection | dump | safe }}{% endif %}{% if wordCount %},
  "wordCount": {{ wordCount }}{% endif %}
}
</script>

{# FAQPage schema for post FAQs is emitted once by schema/site-graph.njk — do not duplicate it here. #}

{% if howTo %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ howTo.name | dump | safe }},
  "description": {{ howTo.description | dump | safe }}{% if howTo.totalTime %},
  "totalTime": "{{ howTo.totalTime }}"{% endif %},
  "step": [{% for s in howTo.steps %}{
    "@type": "HowToStep",
    "position": {{ loop.index }},
    "name": {{ s.name | dump | safe }},
    "text": {{ s.text | dump | safe }}{% if s.url %},
    "url": "{{ s.url }}"{% endif %}
  }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
{% endif %}

<!-- Breadcrumb -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://mcbride-pm.com/"},
    {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://mcbride-pm.com/blog/"},
    {"@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}}
  ]
}
</script>

<!-- BLOG HEADER -->
<div class="blog-header">
  <div class="container">
    <div class="blog-breadcrumb">
      <a href="/">Home</a> › <a href="/blog/">Blog</a>
    </div>
    <h1 class="blog-title">{{ title }}</h1>
    <div class="blog-metadata">
      <span class="blog-metadata-item">{{ date | readableDate }}</span>
      <span class="blog-metadata-item">&middot;</span>
      <span class="blog-metadata-item">{{ readTime or '5' }} min read</span>
      <span class="blog-metadata-item">
        <span class="tag-badge {% if category == 'Property Owners' %}tag-badge--owners{% elif category == 'Tenants' %}tag-badge--tenants{% else %}tag-badge--owners{% endif %}">{{ category }}</span>
      </span>
    </div>
  </div>
</div>

<!-- BLOG CONTENT -->
<section class="content-section">
  <div class="container post-layout">
   <article class="post-main">
    {% if image and (image | exists) %}
    <figure class="post-hero">
      <img src="{{ image }}" alt="{{ imageAlt or title }}" width="1408" height="768" fetchpriority="high">
    </figure>
    {% endif %}
    <div class="back-to-blog">
      <a href="/blog/">&larr; Back to Blog</a>
    </div>

    <div class="blog-body">
      {{ content | safe }}
    </div>

    <!-- CTA -->
    <div class="cta-box" data-sticky-hide>
      <h3>{{ ctaTitle or 'Ready to Talk Property Management?' }}</h3>
      <p>{{ ctaText or 'McBride Property Management handles the details while you enjoy the returns.' }}</p>
      <a href="/contact/" class="btn btn-primary btn-lg">Get a Free Rental Analysis</a>
      <div class="contact-info">
        <p>Or talk to our team about your property</p>
        <p><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a><br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <p class="cta-renters">Looking for a home to rent? <a href="/rentals/">See available rentals &rarr;</a></p>
    </div>

    <!-- Author -->
    <div class="author-sig">
      <strong><a href="/about/">Noah McBride</a>, Broker</strong>
      {{ site.name }}<br>
      706.339.2874<br>
      Managed like it's our own.
    </div>
   </article>

   <!-- Wide screens: an offer that stays beside the article while reading -->
   <aside class="post-aside" aria-label="{% if category == 'Tenants' %}Available rentals{% else %}Free rental analysis{% endif %}">
    <div class="post-aside-card">
      {% if category == 'Tenants' %}
      <p class="post-aside-kicker">Looking for a home?</p>
      <p class="post-aside-title">Browse every rental we have available</p>
      <p>Schedule a showing and apply online in minutes.</p>
      <a class="btn" href="/rentals/">See Available Rentals</a>
      {% else %}
      <p class="post-aside-kicker">Free rental analysis</p>
      <p class="post-aside-title">What should your CSRA rental earn?</p>
      <p>{{ site.contactName }}, our {{ site.contactTitle | lower }}, sends a rent range and a proposal within one business day.</p>
      <a class="btn" href="/contact/" data-open-lead="post-aside">Get My Free Analysis</a>
      {% endif %}
      <a class="post-aside-call" href="tel:{{ site.phoneTel }}">or call {{ site.phone }}</a>
    </div>
   </aside>
  </div>
</section>
{% endblock %}
