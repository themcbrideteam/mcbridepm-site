    <nav class="footer-links" aria-label="Portals and contact">
      <a href="/rentals/">Available Rentals</a>
      <a href="{{ site.ownerPortal }}">Owner Portal</a>
      <a href="{{ site.residentPortal }}">Resident Portal</a>
      <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </nav>
  </div>
  <div class="container footer-rows">
    <nav class="footer-row" aria-label="Explore">
      <span class="footer-row-label">Explore</span>
