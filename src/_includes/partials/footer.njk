    <nav class="footer-row" aria-label="Areas we serve">
      <span class="footer-row-label">Areas</span>
      <a href="/augusta/">Augusta</a>
      <a href="/evans/">Evans</a>
      <a href="/grovetown/">Grovetown</a>
      <a href="/martinez/">Martinez</a>
      <a href="/harlem/">Harlem</a>
      <a href="/hephzibah/">Hephzibah</a>
      <a href="/appling/">Appling</a>
      <a href="/north-augusta/">North Augusta</a>
