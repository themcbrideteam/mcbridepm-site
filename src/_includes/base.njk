<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Augusta property management company serving Georgia and South Carolina. Expert tenant screening, rent collection, maintenance, and financial reporting.' }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta name="author" content="{{ site.name }}">

  {% set _fullTitle = title if (title and (' | ' in title)) else ((title + ' | ' + site.name) if title else site.name) %}
  {% set _ogTitle = ogTitle or _fullTitle %}
  {% set _ogDescription = ogDescription or description or 'Professional property management for residential property owners across the CSRA.' %}
  {% set _ogImage = ogImage or (site.url + image if (image and (image | exists)) else site.url + '/og-image.jpg') %}

  <!-- Open Graph Tags -->
  <meta property="og:title" content="{{ _ogTitle }}">
  <meta property="og:description" content="{{ _ogDescription }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:image" content="{{ _ogImage }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_US">

  <title>{{ _fullTitle }}</title>

  <!-- Fonts (preconnect first so the CSS request can reuse the connection) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

  <!-- Styles: shared core (header, buttons, dialog, footer), then inner pages -->
  <link rel="stylesheet" href="{{ '/css/core.css' | v }}">
  <link rel="stylesheet" href="{{ '/css/styles.css' | v }}">

  {# Backdrop photo behind the page header, by section; front matter `stage` overrides #}
  {% set stageMap = {
    "/services/": "rosewood-kitchen", "/why-hire/": "rosewood-kitchen",
    "/about/": "kingsway-front-twilight", "/contact/": "kingsway-front-twilight", "/referral/": "kingsway-front-twilight",
    "/thank-you/": "kingsway-front-twilight", "/referral-thank-you/": "kingsway-front-twilight",
    "/rentals/": "rosewood-interior", "/resident-faqs/": "rosewood-interior", "/owner-faqs/": "rosewood-interior", "/resources/": "rosewood-interior",
    "/augusta/": "canterbury-aerial", "/evans/": "canterbury-aerial", "/grovetown/": "canterbury-aerial", "/martinez/": "canterbury-aerial",
    "/harlem/": "canterbury-aerial", "/hephzibah/": "canterbury-aerial", "/appling/": "canterbury-aerial",
    "/north-augusta/": "canterbury-aerial", "/aiken/": "canterbury-aerial", "/graniteville/": "canterbury-aerial"
  } %}
  {% set stageImg = stage or stageMap[page.url] or ("rosewood-interior" if "/blog/" in page.url else "rosewood-front-twilight") %}
  <link rel="preload" as="image" imagesrcset="/assets/img/stage/{{ stageImg }}-1080.jpg 1080w, /assets/img/stage/{{ stageImg }}-1920.jpg 1920w" imagesizes="100vw" fetchpriority="high">

  <!-- Canonical, robots, sitemap -->
  <link rel="canonical" href="{{ canonical or (site.url + page.url) }}">
  <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#060644">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ _ogTitle }}">
  <meta name="twitter:description" content="{{ _ogDescription }}">
  <meta name="twitter:image" content="{{ _ogImage }}">

  <!-- Geo signals -->
  <meta name="geo.region" content="US-GA">
  <meta name="geo.placename" content="Evans, Georgia">
  <meta name="geo.position" content="{{ site.latitude }};{{ site.longitude }}">
  <meta name="ICBM" content="{{ site.latitude }}, {{ site.longitude }}">

  <!-- Performance -->
  <link rel="dns-prefetch" href="https://c21magnolia.appfolio.com">

  <!-- Search Console verification -->
  {% if site.buildVerifications.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.buildVerifications.googleSiteVerification }}">{% endif %}
  {% if site.buildVerifications.bingSiteVerification %}<meta name="msvalidate.01" content="{{ site.buildVerifications.bingSiteVerification }}">{% endif %}

  <!-- Schema.org JSON-LD graph -->
  {% include "schema/site-graph.njk" %}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TDYZD9289V"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-TDYZD9289V');
  </script>

  {% block head %}{% endblock %}
</head>
<body>

  <a class="skip-link" href="#main">Skip to main content</a>

  <div class="page-stage" aria-hidden="true">
    <img src="/assets/img/stage/{{ stageImg }}-1920.jpg" srcset="/assets/img/stage/{{ stageImg }}-1080.jpg 1080w, /assets/img/stage/{{ stageImg }}-1920.jpg 1920w" sizes="100vw" alt="" decoding="async">
    <div class="veil"></div>
  </div>

  {% include "partials/header.njk" %}

  <main id="main">
  {% block content %}
    {{ content | safe }}
  {% endblock %}
  </main>

  {% include "partials/footer.njk" %}
  {% if stickyCta !== false %}{% include "partials/sticky-cta.njk" %}{% endif %}
  {% if page.url != "/contact/" %}{% include "partials/lead-dialog.njk" %}{% endif %}

  <script src="{{ '/js/nav.js' | v }}" defer></script>
  <script src="{{ '/js/main.js' | v }}" defer></script>
  <script src="{{ '/js/lead.js' | v }}" defer></script>
  <script>if (/^#(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(location.hash)) location.replace('/admin/' + location.hash);</script>

  {% block scripts %}{% endblock %}
</body>
</html>
