<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Augusta property management company serving Georgia and South Carolina. Expert tenant screening, rent collection, maintenance, and financial reporting.' }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta name="author" content="{{ site.name }}">

  {% set _fullTitle = title if (title and (' | ' in title)) else ((title + ' | ' + site.name) if title else site.name) %}
  {% set _ogTitle = ogTitle or _fullTitle %}
  {% set _ogDescription = ogDescription or description or 'Professional property management for residential property owners across the CSRA.' %}
  {% set _ogImage = ogImage or (site.url + image if image else site.url + '/og-image.jpg') %}

  <!-- Open Graph Tags -->
  <meta property="og:title" content="{{ _ogTitle }}">
  <meta property="og:description" content="{{ _ogDescription }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:image" content="{{ _ogImage }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_US">

  <title>{{ _fullTitle }}</title>

  <!-- Fonts (preconnect first so the CSS request can reuse the connection) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Canonical, robots, sitemap -->
  <link rel="canonical" href="{{ canonical or (site.url + page.url) }}">
  <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#060644">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ _ogTitle }}">
  <meta name="twitter:description" content="{{ _ogDescription }}">
  <meta name="twitter:image" content="{{ _ogImage }}">

  <!-- Geo signals -->
  <meta name="geo.region" content="US-GA">
  <meta name="geo.placename" content="Evans, Georgia">
  <meta name="geo.position" content="{{ site.latitude }};{{ site.longitude }}">
  <meta name="ICBM" content="{{ site.latitude }}, {{ site.longitude }}">

  <!-- Performance -->
  <link rel="dns-prefetch" href="https://c21magnolia.appfolio.com">

  <!-- Search Console verification -->
  {% if site.buildVerifications.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.buildVerifications.googleSiteVerification }}">{% endif %}
  {% if site.buildVerifications.bingSiteVerification %}<meta name="msvalidate.01" content="{{ site.buildVerifications.bingSiteVerification }}">{% endif %}

  <!-- Schema.org JSON-LD graph -->
  {% include "schema/site-graph.njk" %}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TDYZD9289V"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-TDYZD9289V');
  </script>

  {% block head %}{% endblock %}
</head>
<body>

  <a class="skip-link" href="#main">Skip to main content</a>

  <!-- TOP BAR -->
  <div class="topbar">
    <div class="container">
      {% if topbarText %}
      <span>{{ topbarText }}</span>
      <div class="topbar-links">
        <a href="{{ site.ownerPortal }}">Owner Portal</a>
        <a href="{{ site.residentPortal }}">Resident Portal</a>
        <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>
      </div>
      {% else %}
      <div class="topbar-links">
        <a href="{{ site.ownerPortal }}">Owner Portal</a>
        <a href="{{ site.residentPortal }}">Resident Portal</a>
        <a href="/rentals/">Available Rentals</a>
      </div>
      <div class="topbar-links">
        <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
      {% endif %}
    </div>
  </div>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="container">
      <a href="/" class="logo">McBride <span>PM</span></a>

      <button class="hamburger" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="nav-links">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <ul class="nav-links" id="nav-links">
        <li class="dropdown">
          <a href="/rentals/">Residents</a>
          <div class="dropdown-menu">
            <a href="/rentals/">Available Properties</a>
            <a href="/resident-faqs/">Resident FAQs</a>
            <a href="{{ site.residentPortal }}">Resident Portal</a>
          </div>
        </li>

        <li class="dropdown">
          <a href="/services/">Owners</a>
          <div class="dropdown-menu">
            <a href="/services/">PM Services</a>
            <a href="/why-hire/">Why Hire Us</a>
            <a href="/owner-faqs/">Owner FAQs</a>
            <a href="{{ site.ownerPortal }}">Owner Portal</a>
          </div>
        </li>

        <li class="dropdown">
          <a href="/#all-areas">Areas We Serve</a>
          <div class="dropdown-menu">
            <a href="/augusta/">Augusta</a>
            <a href="/evans/">Evans</a>
            <a href="/grovetown/">Grovetown</a>
            <a href="/martinez/">Martinez</a>
            <a href="/harlem/">Harlem</a>
            <a href="/hephzibah/">Hephzibah</a>
            <a href="/appling/">Appling</a>
            <a href="/north-augusta/">North Augusta</a>
            <a href="/aiken/">Aiken</a>
            <a href="/graniteville/">Graniteville</a>
            <a href="/#all-areas">See All Areas</a>
          </div>
        </li>

        <li><a href="/about/">About</a></li>
        <li><a href="/resources/">Resources</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/referral/">Agent Referral</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/contact/" class="btn btn-primary btn-sm">Free Rental Analysis</a></li>
      </ul>
    </div>
  </nav>

  <main id="main">
  {% block content %}
    {{ content | safe }}
  {% endblock %}
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-logo">McBride <span>PM</span></div>
          <p style="margin-bottom: 1rem;">{{ site.address }}<br>{{ site.city }}</p>
          <p style="margin-bottom: .5rem;"><strong><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a></strong></p>
          <p style="margin-bottom: 1.5rem;"><strong><a href="mailto:{{ site.email }}">{{ site.email }}</a></strong></p>
          <div class="tagline">Managed like it's our own.</div>
        </div>

        <div>
          <div class="footer-heading">Quick Links</div>
          <ul>
            <li><a href="/services/">Our Services</a></li>
            <li><a href="/why-hire/">Why Hire Us</a></li>
            <li><a href="/about/">About Us</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/contact/">Contact Us</a></li>
            <li><a href="/contact/">Free Rental Analysis</a></li>
          </ul>
        </div>

        <div>
          <div class="footer-heading">Areas We Serve</div>
          <ul>
            <li><a href="/augusta/">Augusta</a></li>
            <li><a href="/evans/">Evans</a></li>
            <li><a href="/grovetown/">Grovetown</a></li>
            <li><a href="/martinez/">Martinez</a></li>
            <li><a href="/harlem/">Harlem</a></li>
            <li><a href="/hephzibah/">Hephzibah</a></li>
            <li><a href="/appling/">Appling</a></li>
            <li><a href="/north-augusta/">North Augusta</a></li>
            <li><a href="/aiken/">Aiken</a></li>
            <li><a href="/graniteville/">Graniteville</a></li>
            <li><a href="/#all-areas">See All Areas</a></li>
          </ul>
        </div>

        <div>
          <div class="footer-heading">Portal Access</div>
          <ul>
            <li><a href="{{ site.ownerPortal }}">Owner Portal</a></li>
            <li><a href="{{ site.residentPortal }}">Resident Portal</a></li>
            <li><a href="/rentals/">Available Rentals</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>&copy; 2026 {{ site.name }}. All rights reserved.</div>
        <div>
          <a href="/privacy/">Privacy Policy</a> | <a href="/terms/">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="/js/main.js" defer></script>
  <script>if (/^#(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(location.hash)) location.replace('/admin/' + location.hash);</script>

  {% block scripts %}{% endblock %}
</body>
</html>
