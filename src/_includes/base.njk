<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Augusta property management company serving Georgia and South Carolina. Expert tenant screening, rent collection, maintenance, and financial reporting.' }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta name="author" content="{{ site.name }}">

  <!-- Open Graph Tags -->
  <meta property="og:title" content="{{ title }} | {{ site.name }}">
  <meta property="og:description" content="{{ description or 'Professional property management for residential property owners across the CSRA.' }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:image" content="{{ site.url }}/og-image.jpg">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">

  <title>{{ title }} | {{ site.name }}</title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Canonical, robots, sitemap -->
    <link rel="canonical" href="{{ canonical or (site.url + page.url) }}">
      <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
        <link rel="sitemap" type="application/xml" href="/sitemap.xml">

          <!-- Favicons -->
            <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
              <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
                <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
                  <link rel="manifest" href="/site.webmanifest">
                    <meta name="theme-color" content="#1a3a5c">

                      <!-- Twitter Card -->
                        <meta name="twitter:card" content="summary_large_image">
                          <meta name="twitter:title" content="{{ title }} | {{ site.name }}">
                            <meta name="twitter:description" content="{{ description or 'Professional property management for residential property owners across the CSRA.' }}">
                              <meta name="twitter:image" content="{{ site.url }}/og-image.jpg">

                                <!-- OG site_name -->
                                  <meta property="og:site_name" content="{{ site.name }}">
                                    <meta property="og:image:width" content="1200">
                                      <meta property="og:image:height" content="630">
                                        <meta property="og:locale" content="en_US">

                                          <!-- Geo signals -->
                                            <meta name="geo.region" content="US-GA">
                                              <meta name="geo.placename" content="Evans, Georgia">
                                                <meta name="geo.position" content="{{ site.latitude }};{{ site.longitude }}">
                                                  <meta name="ICBM" content="{{ site.latitude }}, {{ site.longitude }}">

                                                    <!-- Performance -->
                                                      <link rel="preconnect" href="https://fonts.googleapis.com">
                                                        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
                                                          <link rel="dns-prefetch" href="https://c21magnolia.appfolio.com">

                                                            <!-- Search Console verification -->
                                                              {% if site.buildVerifications.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.buildVerifications.googleSiteVerification }}">{% endif %}
                                                                {% if site.buildVerifications.bingSiteVerification %}<meta name="msvalidate.01" content="{{ site.buildVerifications.bingSiteVerification }}">{% endif %}

                                                                  <!-- Schema.org JSON-LD graph -->
                                                                    {% include "schema/site-graph.njk" %}
                                                                    
  <!-- Netlify Identity (required for Decap CMS login) -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

  {% block head %}{% endblock %}
</head>
<body>

  <!-- TOP BAR -->
  <div class="topbar">
    <div class="container">
      <div class="topbar-links">
        <a href="{{ site.ownerPortal }}">Owner Portal</a>
        <a href="{{ site.residentPortal }}">Resident Portal</a>
        <a href="/rentals.html">Available Rentals</a>
      </div>
      <div class="topbar-links">
        <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
    </div>
  </div>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="container">
      <a href="/" class="logo">McBride <span>PM</span></a>

      <button class="hamburger" aria-label="Toggle navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <ul class="nav-links">
        <li class="dropdown">
          <a href="#residents">Residents</a>
          <div class="dropdown-menu">
            <a href="/rentals.html">Available Properties</a>
            <a href="#resident-faqs">Resident FAQs</a>
            <a href="{{ site.residentPortal }}">Resident Portal</a>
          </div>
        </li>

        <li class="dropdown">
          <a href="#owners">Owners</a>
          <div class="dropdown-menu">
            <a href="/services.html">PM Services</a>
            <a href="/why-hire.html">Why Hire Us</a>
            <a href="#owner-faqs">Owner FAQs</a>
            <a href="{{ site.ownerPortal }}">Owner Portal</a>
          </div>
        </li>

        <li class="dropdown">
          <a href="#areas">Areas We Serve</a>
          <div class="dropdown-menu">
            <a href="#augusta">Augusta</a>
            <a href="/evans.html">Evans</a>
            <a href="#grovetown">Grovetown</a>
            <a href="#martinez">Martinez</a>
            <a href="#north-augusta">North Augusta</a>
            <a href="#aiken">Aiken</a>
            <a href="#columbia-county">Columbia County</a>
            <a href="#all-areas">See All Areas</a>
          </div>
        </li>

        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contact.html">Contact</a></li>
        <li><a href="/contact.html" class="btn btn-primary btn-sm">Free Rental Analysis</a></li>
      </ul>
    </div>
  </nav>

  {% block content %}
    {{ content | safe }}
  {% endblock %}

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-logo">McBride <span>PM</span></div>
          <p style="margin-bottom: 1rem;">{{ site.address }}<br>{{ site.city }}</p>
          <p style="margin-bottom: .5rem;"><strong><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a></strong></p>
          <p style="margin-bottom: 1.5rem;"><strong><a href="mailto:{{ site.email }}">{{ site.email }}</a></strong></p>
          <div class="tagline">Guiding you home.</div>
        </div>

        <div>
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/services.html">Our Services</a></li>
            <li><a href="/why-hire.html">Why Hire Us</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/contact.html">Contact Us</a></li>
            <li><a href="/contact.html">Free Rental Analysis</a></li>
          </ul>
        </div>

        <div>
          <h4>Areas We Serve</h4>
          <ul>
            <li><a href="#">Augusta</a></li>
            <li><a href="/evans.html">Evans</a></li>
            <li><a href="#">Grovetown</a></li>
            <li><a href="#">Martinez</a></li>
            <li><a href="#">Aiken</a></li>
            <li><a href="#">North Augusta</a></li>
            <li><a href="#">See All Areas</a></li>
          </ul>
        </div>

        <div>
          <h4>Portal Access</h4>
          <ul>
            <li><a href="{{ site.ownerPortal }}">Owner Portal</a></li>
            <li><a href="{{ site.residentPortal }}">Resident Portal</a></li>
            <li><a href="/rentals.html">Available Rentals</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>&copy; 2026 {{ site.name }}. All rights reserved.</div>
        <div>
          <a href="#privacy">Privacy Policy</a> | <a href="#terms">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
