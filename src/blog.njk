---
layout: base.njk
title: "Property Management Blog"
description: "Property management insights, rental market updates, and expert advice for landlords and tenants in Augusta and Columbia County, GA."
permalink: /blog/
---

{% block head %}
<style>
  .page-header {
    background: linear-gradient(135deg, #060644 0%, #0d0d5d 100%);
    color: white;
    padding: 3rem 0;
  }
  .page-header .breadcrumb {
    font-size: 0.95rem;
    margin-bottom: 1rem;
    opacity: 0.9;
  }
  .page-header .breadcrumb a {
    color: #b2995a;
    text-decoration: none;
  }
  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    opacity: 0.9;
    font-size: 1.1rem;
  }
  .content-section {
    padding: 3rem 0;
  }
  .content-narrow {
    max-width: 800px;
    margin: 0 auto;
  }
  .blog-card {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid #e8e8e8;
  }
  .blog-card:last-child {
    border-bottom: none;
  }
  .blog-card .category-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
    color: #fff;
  }
  .blog-card .category-badge--owners {
    background: #060644;
  }
  .blog-card .category-badge--tenants {
    background: #b2995a;
  }
  .blog-card h2 {
    margin-bottom: 0.75rem;
  }
  .blog-card h2 a {
    color: #060644;
    text-decoration: none;
  }
  .blog-card h2 a:hover {
    color: #b2995a;
  }
  .blog-card .date {
    color: #888;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .blog-card .excerpt {
    color: #555;
    line-height: 1.7;
  }
  .blog-card .read-more {
    color: #b2995a;
    font-weight: 600;
    text-decoration: none;
  }
  .blog-card .read-more:hover {
    text-decoration: underline;
  }
</style>
{% endblock %}

{% block content %}
<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> > Blog
    </div>
    <h1>Property Management Blog</h1>
    <p>Expert insights for property owners and tenants in Augusta and Columbia County</p>
  </div>
</div>

<!-- Blog Posts -->
<div class="content-section">
  <div class="container content-narrow">
    {% for post in collections.blog %}
    <article class="blog-card">
      <span class="category-badge {% if post.data.category == 'Property Owners' %}category-badge--owners{% elif post.data.category == 'Tenants' %}category-badge--tenants{% else %}category-badge--owners{% endif %}">{{ post.data.category }}</span>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p class="date">{{ post.date | readableDate }}</p>
      <p class="excerpt">{{ post.data.description }}</p>
      <a href="{{ post.url }}" class="read-more">Read more &rarr;</a>
    </article>
    {% endfor %}

    {% if collections.blog.length == 0 %}
    <p>No blog posts yet. Check back soon!</p>
    {% endif %}
  </div>
</div>

<!-- Owner CTA -->
<div class="cta-section">
  <div class="container text-center">
    <h2>Own Rental Property in Augusta?</h2>
    <p>Find out how McBride Property Management can protect your investment and save you time. Talk to Amber, our Business Development Manager.</p>
    <a href="tel:{{ site.phoneTel }}" class="btn btn-outline btn-lg">Call {{ site.phone }}</a>
  </div>
</div>
{% endblock %}
